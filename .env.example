# Copiez ce fichier en « .env » pour travailler en local. Ne publiez jamais .env.
# Sur Netlify, ces valeurs se saisissent dans : Site configuration → Environment variables.

# ---- PUBLIQUES (envoyées au navigateur, c'est normal et sans danger) ----
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...clé-anon-publique...
VITE_VAPID_PUBLIC_KEY=
# Plus tard (avec le vrai domaine) :
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_SYMBOL=

# ---- SECRÈTES (serveur uniquement, ne jamais préfixer par VITE_) ----
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votredomaine.com
# Source de prix côté serveur (portefeuille + alertes). Vide = désactivé.
EODHD_API_KEY=
# Paiements Stripe (laisser vide = paiement désactivé)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CHF_MONTHLY=
STRIPE_PRICE_CHF_YEARLY=
STRIPE_PRICE_EUR_MONTHLY=
STRIPE_PRICE_EUR_YEARLY=
STRIPE_AUTOMATIC_TAX=
# 1 = prix FICTIFS pour tester en local. Ne jamais activer sur le site public.
QUOTES_DEMO=
