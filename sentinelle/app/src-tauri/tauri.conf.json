{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentinelle",
  "version": "0.8.0",
  "identifier": "ch.sentinelle.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "principale",
        "title": "Sentinelle",
        "width": 1200,
        "height": 780,
        "minWidth": 520,
        "minHeight": 480,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": { "effects": ["underWindowBackground", "mica"], "state": "active" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
