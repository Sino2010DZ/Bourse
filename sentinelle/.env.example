# Copiez ce fichier sous le nom « .env » (dans le même dossier), puis collez votre clé.
# Le fichier .env reste sur votre Mac : il n'est jamais envoyé sur GitHub.

# Clé API Anthropic (commence par sk-ant-…) — à créer sur https://platform.claude.com
ANTHROPIC_API_KEY=

# Modèles (vous pouvez les laisser tels quels)
MODELE_GRAND_CHEF=claude-opus-5-5
MODELE_AGENTS=claude-haiku-5-5

# Effort de réflexion du Grand Chef : low, medium, high (low = plus rapide et moins cher)
EFFORT_GRAND_CHEF=low

# Port du serveur local (uniquement sur votre ordinateur)
PORT=8765
